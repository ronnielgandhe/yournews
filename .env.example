# Feature flags (defaults off)
AI_MULTI_QUERY_ENABLED=false
AI_TIMELINE_ENABLED=false
AI_COMPARISON_ENABLED=false
AI_SUMMARY_LEVELS_ENABLED=false
AI_EXPORT_ENABLED=false
AI_PERSONAL_FEED_ENABLED=false
AI_BIAS_LENS_ENABLED=false

# Client-visible flags (prefix NEXT_PUBLIC_ to expose to the browser)
NEXT_PUBLIC_AI_MULTI_QUERY_ENABLED=false
NEXT_PUBLIC_AI_TIMELINE_ENABLED=false
NEXT_PUBLIC_AI_COMPARISON_ENABLED=false
NEXT_PUBLIC_AI_SUMMARY_LEVELS_ENABLED=false
NEXT_PUBLIC_AI_EXPORT_ENABLED=false
NEXT_PUBLIC_AI_PERSONAL_FEED_ENABLED=false
NEXT_PUBLIC_AI_BIAS_LENS_ENABLED=false

# OpenAI key (leave empty in example)
OPENAI_API_KEY=

# Next public config
NEXT_PUBLIC_APP_NAME=YourNews
